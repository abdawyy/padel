APP_NAME=Padel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:8000

BRAND_LOGO=/images/brand/logo.svg
BRAND_FAVICON=/images/brand/favicon.svg
BRAND_PRIMARY=#d97706
APP_CURRENCY=EGP

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Database (MySQL recommended for production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=padel
DB_USERNAME=root
DB_PASSWORD=

# Queue & cache (use redis in production for queues)
QUEUE_CONNECTION=database
CACHE_STORE=database

# Session / Sanctum (SPA + Filament panels)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# Mail
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Auth
REQUIRE_EMAIL_VERIFICATION=false

# Paymob (EGP)
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=EGP
PAYMOB_DEFAULT_BILLING_PHONE=+201000000000
# Comma-separated IPs; leave empty to allow all webhook sources
PAYMOB_WEBHOOK_ALLOWED_IPS=

# Booking behaviour
BOOKING_PENDING_PAYMENT_HOLD_MINUTES=30
BOOKING_FULL_REFUND_HOURS_BEFORE=24
BOOKING_ALLOW_CANCEL_AFTER_START=false
